{
  "name": "cherryville",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=cherryville-client",
    "build:client": "npm run build --workspace=cherryville-client",
    "lint": "npm run lint --workspace=cherryville-client",
    "dev:server": "npm run dev --workspace=cherryville-server",
    "build:server": "npm run build --workspace=cherryville-server",
    "start:server": "npm run start --workspace=cherryville-server"
  }
}