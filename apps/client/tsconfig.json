{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "es2015",
    "target": "es2025",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler"
  },
  "include": [
    "src",
    "custom.d.ts"
  ]
}